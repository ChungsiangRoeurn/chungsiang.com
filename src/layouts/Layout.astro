---
import '../styles/global.css';

const { title = 'Chungsiang Roeurn — Developer', description = 'The portfolio of Chungsiang Roeurn, a developer building useful digital products.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<main><slot /></main>
		<footer class="site-footer">
			<a class="footer-return" href="/">← Return to home</a>
			<div class="bookmark-plaque">
				<strong class="bookmark-title">Bookmark</strong>
				<div class="bookmark-details"><span>Chungsiang Roeurn</span><span>Phnom Penh · Cambodia</span></div>
			</div>
		</footer>
	</body>
</html>
