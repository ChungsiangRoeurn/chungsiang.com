---
import Layout from '../layouts/Layout.astro';
import WindowPanel from '../components/WindowPanel.astro';
---

<Layout title="404 — Chungsiang Roeurn">
	<section class="not-found-shell">
		<div class="not-found-panel">
			<WindowPanel filename="404.html">
				<div class="not-found-content">
					<p class="eyebrow">Error / Page not found</p>
					<h1>404</h1>
					<p>This page isn’t in the collection.</p>
					<a class="text-link" href="/">Return home</a>
				</div>
			</WindowPanel>
		</div>
	</section>
</Layout>