---
import Layout from '../layouts/Layout.astro';

const projects = [
	{ year: '2024', name: 'Sangkat', description: 'A civic platform that makes neighborhood services easier to find, understand, and use.', stack: 'React · TypeScript · Node.js', image: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=80' },
	{ year: '2023', name: 'Mekong House', description: 'A warm, flexible identity and website for a new kind of shared creative space.', stack: 'Astro · CSS · JavaScript', image: 'https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1200&q=80' },
	{ year: '2022', name: 'Field Notes', description: 'A small publishing system for generous observations about life in the city.', stack: 'Astro · Markdown · TypeScript', image: 'https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1200&q=80' },
	{ year: '2021', name: 'Rove', description: 'An easier way to plan unhurried journeys through Southeast Asia.', stack: 'React · TypeScript · Map APIs', image: 'https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1200&q=80' },
];
---

<Layout title="Work — Chungsiang Roeurn">
	<section class="page-shell">
		<a class="back-link" href="/">← Back to overview</a>
		<div class="header-box">
			<p class="eyebrow">Work</p>
			<h1 class="display-title">A few things<br /><em>I have built.</em></h1>
			<p class="description">Selected project ideas with descriptions of the problem, product, and thinking behind each one.</p>
		</div>
		<div class="details-box mt-3">
			<p class="eyebrow">Selected projects</p>
			<div class="mt-8 grid gap-4 sm:grid-cols-2">
				{projects.map((project) => <a class="project-card" href="https://github.com/ChungsiangRoeurn" target="_blank" rel="noreferrer"><div class="project-card-image"><img src={project.image} alt={`${project.name} project demo`} loading="lazy" /></div><div class="project-card-content"><div class="project-card-kicker"><span>Selected work</span><span>{project.year}</span></div><h2 class="project-card-title">{project.name}</h2><p class="project-card-description">{project.description}</p><p class="project-card-stack">{project.stack}</p></div></a>)}
			</div>
		</div>
	</section>
</Layout>
