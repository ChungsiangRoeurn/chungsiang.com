---
import Layout from '../layouts/Layout.astro';
import WindowPanel from '../components/WindowPanel.astro';
import { sectionContent, roleIntroduction, roleHighlights, employmentHistory, projects, toolkitGroups } from '../data/site';

export function getStaticPaths() {
	return Object.keys(sectionContent).map((section) => ({ params: { section }, props: { section } }));
}

const { section } = Astro.props;
const page = sectionContent[section as keyof typeof sectionContent];
---

<Layout title={`${page.eyebrow} — Chungsiang Roeurn`}>
	<section class="page-shell">
		<a class="back-link" href="/">Back to overview</a>
		<header class="page-heading">
			<p class="eyebrow">{page.eyebrow}</p>
			<h1 class="page-title">{page.title}<br /><em>{page.accent}</em></h1>
			<p class="page-description">{page.description}</p>
		</header>

		{section === 'role' && <WindowPanel filename="role-overview.html">
			<p class="role-intro">{roleIntroduction}</p>
			<div class="role-highlight-grid">{roleHighlights.map((highlight) => <div><strong>{highlight.title}</strong><p>{highlight.description}</p></div>)}</div>
		</WindowPanel>}

		{section === 'experience' && <WindowPanel filename="experience-history.html">
			<div class="experience-groups">{employmentHistory.map((job) => <div class="experience-group">
				<div class="experience-company"><strong>{job.company}</strong><span>{job.period}</span></div>
				<div class="detail-list">{job.roles.map((role) => <div class="detail-item"><span>{role.date}</span><strong>{role.title}</strong><p>{role.text}</p></div>)}</div>
			</div>)}</div>
		</WindowPanel>}

		{section === 'projects' && <div class="project-grid route-panel">
			{projects.map((project, index) => <WindowPanel filename={`project-${index + 1}.html`}>
				<a class="project-card" href={project.href} target="_blank" rel="noreferrer">
					<div class="project-card-image"><img src={project.image} alt={`${project.name} project preview`} loading="lazy" /></div>
					<div class="project-card-content">
						<div class="project-card-kicker"><span>{project.type}</span><span>{project.year}</span></div>
						<h2 class="project-card-title">{project.name}</h2>
						<p class="project-card-description">{project.description}</p>
						<p class="project-card-stack">{project.stack}</p>
					</div>
				</a>
			</WindowPanel>)}
		</div>}

		{section === 'toolkit' && <WindowPanel filename="toolkit-index.html">
			<div class="toolkit-groups">{toolkitGroups.map((group) => <div class="toolkit-group"><p class="eyebrow">{group.label}</p><div>{group.tools.map((tool) => <span class="tool-chip">{tool}</span>)}</div></div>)}</div>
		</WindowPanel>}
	</section>
</Layout>
