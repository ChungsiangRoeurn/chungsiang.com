---
import Layout from '../layouts/Layout.astro';
import WindowPanel from '../components/WindowPanel.astro';
import { homeContent, homeSections, contactLinks, projects, roleHighlights } from '../data/site';
---

<Layout title={homeContent.title}>
	<section class="site-shell" id="top">
		<div class="home-hero">
			<div class="hero-copy">
				<p class="eyebrow">{homeContent.name} {homeContent.surname} / Developer</p>
				<h1 class="hero-title">Hello.<br />I’m {homeContent.name}.</h1>
				<p class="hero-description">{homeContent.description}</p>
				<a class="text-link" href="/projects">See selected work</a>
			</div>
			<div class="hero-window" aria-label="Areas of work">
				<div class="hero-window-bar"><span>work-overview.txt</span><span>01—03</span></div>
				<div class="hero-window-body">
					{roleHighlights.map((item, index) => <div class="hero-window-row"><span>0{index + 1}</span><div><strong>{item.title}</strong><p>{item.description}</p></div></div>)}
				</div>
			</div>
		</div>

		<nav class="quick-links" aria-label="Portfolio pages">
			<span class="quick-links-label">Quick links</span>
			{homeSections.filter((section) => section.href).map((section) => <a class="quick-link" href={section.href}>{section.title}</a>)}
		</nav>
	</section>

	<section class="section-band" id="projects">
		<div class="section-inner">
			<div class="section-heading">
				<div><h2>Selected projects</h2><p>Recent work / swipe or use arrows</p></div>
				<div class="slider-controls" aria-label="Project slider controls">
					<span data-project-count>01 / 03</span>
					<button type="button" data-project-previous aria-label="Previous project" disabled>←</button>
					<button type="button" data-project-next aria-label="Next project">→</button>
				</div>
			</div>
			<div class="project-slider" data-project-slider role="region" aria-label="Selected projects" tabindex="0">
				{projects.map((project, index) => <div class="project-slide" data-project-slide>
					<WindowPanel filename={`project-${index + 1}.html`}>
						<a class="project-card" href={project.href} target="_blank" rel="noreferrer">
							<div class="project-card-image"><img src={project.image} alt={`${project.name} project preview`} loading="lazy" /></div>
							<div class="project-card-content">
								<div class="project-card-kicker"><span>{project.type}</span><span>{project.year}</span></div>
								<h3 class="project-card-title">{project.name}</h3>
								<p class="project-card-description">{project.description}</p>
								<p class="project-card-stack">{project.stack}</p>
							</div>
						</a>
					</WindowPanel>
				</div>)}
			</div>
		</div>
	</section>

	<section class="site-shell home-bottom">
		<figure class="computer-figure">
			<img src="/images/retro-computer.png" alt="Black-and-white illustration of a desktop computer" loading="lazy" />
			<figcaption>Digital products / made with care</figcaption>
		</figure>
		<WindowPanel filename="contact.html">
			<div class="contact-map" role="img" aria-label="Abstract monochrome map marked Phnom Penh, Cambodia">
				<span class="contact-map-marker" aria-hidden="true"></span>
				<span class="contact-map-label">Phnom Penh / Cambodia</span>
			</div>
			<div class="contact-card-body">
				<p class="eyebrow">Get in touch</p>
				<h2>Have a good project in mind?</h2>
				<p>Open to thoughtful products and select collaborations.</p>
				<a class="contact-primary" href={contactLinks[0].href}>Email Chungsiang <span aria-hidden="true">↗</span></a>
				<div class="contact-list">
					{contactLinks.slice(1).map((link) => <a class="contact-link" href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
				</div>
			</div>
		</WindowPanel>
	</section>
</Layout>

<script>
	const slider = document.querySelector<HTMLElement>('[data-project-slider]');
	const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-project-slide]'));
	const count = document.querySelector<HTMLElement>('[data-project-count]');
	const previous = document.querySelector<HTMLButtonElement>('[data-project-previous]');
	const next = document.querySelector<HTMLButtonElement>('[data-project-next]');

	function updateSliderControls() {
		if (!slider || slides.length === 0) return;
		const slideStep = slides[0].getBoundingClientRect().width + Number.parseFloat(getComputedStyle(slider).columnGap);
		const currentIndex = Math.min(slides.length - 1, Math.round(slider.scrollLeft / slideStep));
		if (count) count.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
		if (previous) previous.disabled = slider.scrollLeft <= 2;
		if (next) next.disabled = slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 2;
	}

	function moveSlider(direction: number) {
		if (!slider || slides.length === 0) return;
		const slideStep = slides[0].getBoundingClientRect().width + Number.parseFloat(getComputedStyle(slider).columnGap);
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		slider.scrollBy({ left: direction * slideStep, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
	}

	previous?.addEventListener('click', () => moveSlider(-1));
	next?.addEventListener('click', () => moveSlider(1));
	slider?.addEventListener('scroll', updateSliderControls, { passive: true });
	window.addEventListener('resize', updateSliderControls);
	updateSliderControls();
</script>