---
import Layout from '../layouts/Layout.astro';
import CatWithWrySmile from '../components/CatWithWrySmile.astro';
import EmailFill16 from '../components/EmailFill16.astro';
import Github from '../components/Github.astro';
import Linkedin from '../components/Linkedin.astro';
import DateSolidAlerted from '../components/DateSolidAlerted.astro';
import Time from '../components/Time.astro';

const sections = [
	{ title: 'About me', summary: 'From interface to database', description: 'Web applications, desktop tools, and maintainable systems.', href: '/about' },
	{ title: 'Role', summary: 'Web, backend & desktop', description: 'Frontend web, backend APIs, desktop applications, and Telegram integrations.' },
	{ title: 'Experience', summary: 'Web, mobile & product', description: 'From dreamsLAB and freelance web work to mobile product development.', href: '/experience' },
	{ title: 'Projects', summary: 'Selected work', description: 'Projects and the thinking behind them.', href: '/projects' },
	{ title: 'Toolkit', summary: 'A practical stack', description: 'Frontend, mobile, APIs, databases, desktop, and product workflow tools.', href: '/toolkit' },
	{ title: 'Connect with me', summary: 'Let’s work together', description: 'Open to thoughtful products and select projects.' },
];

const contactLinks = [
	{ label: 'Email', href: 'mailto:rn.chungsiang@gmail.com', icon: 'mail', title: 'Email rn.chungsiang@gmail.com' },
	{ label: 'GitHub', href: 'https://github.com/ChungsiangRoeurn', icon: 'github' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com', icon: 'linkedin' },
];
---

<Layout title="Chungsiang Roeurn — Frontend developer" showHeader={false}>
	<section class="page-shell">
		<div class="intro-box text-center">
			<div class="intro-toolbar">
				<div class="intro-datetime" aria-label="Current local date and time"><span><DateSolidAlerted size="0.9rem" /><time data-current-date></time></span><span><Time size="0.9rem" /><time data-current-time></time></span></div>
				<button class="theme-toggle inline-flex size-12 items-end justify-center border-0 bg-transparent p-0 text-neutral-700 hover:text-neutral-950 dark:text-[#f2f0e8] dark:hover:text-white" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
					<span class="theme-toggle-string" aria-hidden="true"></span>
					<span class="theme-toggle-icon"><CatWithWrySmile size="1.75rem" /></span>
				</button>
			</div>
			<h1 class="display-title mx-auto mt-2 max-w-4xl text-3xl sm:text-5xl">Chungsiang <span class="text-neutral-500 dark:text-neutral-400">Roeurn</span></h1>
			<p class="description mx-auto mt-3 max-w-lg text-sm sm:text-base">Building dependable digital products across frontend web, backend APIs, desktop applications, and Telegram integrations.</p>
		</div>

		<nav class="mt-3 grid gap-3 sm:grid-cols-2" aria-label="Portfolio sections">
			{sections.map((section) => (
				section.href || section.title === 'Role' ? <a class="group flex min-h-40 flex-col justify-between border border-neutral-200 bg-white p-5 hover:border-neutral-950 dark:border-[#39413d] dark:bg-[#252b29] dark:hover:border-[#f2f0e8]" href={section.title === 'Role' ? '/role' : section.href}>
					<div class="flex items-center justify-between font-mono text-xs uppercase tracking-[0.12em] text-neutral-500 dark:text-neutral-400"><span>{section.title}</span><span aria-hidden="true" class="text-base transition-transform group-hover:-translate-y-1 group-hover:translate-x-1">↗</span></div>
					<div><strong class="text-base font-medium text-neutral-950 dark:text-neutral-50">{section.summary}</strong><p class="meta mt-2">{section.description}</p></div>
				</a> : <div class="connect-card flex min-h-40 items-center justify-between gap-6 border border-neutral-200 bg-white p-5 dark:border-[#39413d] dark:bg-[#252b29]">
					<div class="min-w-0">
						<div class="font-mono text-xs uppercase tracking-[0.12em] text-neutral-500 dark:text-neutral-400"><span>{section.title}</span></div>
						<strong class="mt-3 block text-base font-medium text-neutral-950 dark:text-neutral-50">{section.summary}</strong>
						<p class="meta mt-2">{section.description}</p>
					</div>
					<div class="flex shrink-0 flex-col items-stretch gap-2">
							{contactLinks.map((link) => <a class="inline-flex items-center gap-2 border border-neutral-300 px-3 py-2 font-mono text-xs text-neutral-600 hover:border-neutral-950 hover:text-neutral-950 dark:border-[#39413d] dark:text-[#9da59e] dark:hover:border-[#f2f0e8] dark:hover:text-[#f2f0e8]" href={link.href} target={link.icon === 'mail' ? undefined : '_blank'} rel={link.icon === 'mail' ? undefined : 'noreferrer'} aria-label={link.title ?? link.label} title={link.title ?? link.label}>
								{link.icon === 'github' ? <Github size="1rem" /> : link.icon === 'linkedin' ? <Linkedin size="1rem" /> : <EmailFill16 size="1rem" />}
								{link.label}
							</a>)}
						</div>
				</div>
			))}
		</nav>

	</section>
</Layout>

<script>
	const dateElement = document.querySelector<HTMLElement>('[data-current-date]');
	const timeElement = document.querySelector<HTMLElement>('[data-current-time]');

	function updateClock() {
		const now = new Date();
		if (dateElement) dateElement.textContent = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(now);
		if (timeElement) timeElement.textContent = new Intl.DateTimeFormat(undefined, { timeStyle: 'short' }).format(now);
	}

	updateClock();
	setInterval(updateClock, 60_000);
</script>
