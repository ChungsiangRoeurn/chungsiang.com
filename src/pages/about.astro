---
import Layout from '../layouts/Layout.astro';
import WindowPanel from '../components/WindowPanel.astro';
import { aboutContent, aboutPillars, aboutBackground, education, employmentHistory, skillGroups } from '../data/site';
---

<Layout title={aboutContent.title}>
	<section class="page-shell">
		<a class="back-link" href="/">Back to overview</a>
		<header class="page-heading">
			<p class="eyebrow">{aboutContent.eyebrow}</p>
			<h1 class="page-title">{aboutContent.headline}</h1>
			<p class="page-description">{aboutContent.description}</p>
		</header>

		<div class="about-grid">
			<WindowPanel filename="about-overview.txt">
				<p class="eyebrow">{aboutContent.bringHeading}</p>
				<div class="about-pillars">
					{aboutPillars.map((pillar) => <article class="about-pillar"><span>{pillar.number}</span><h2>{pillar.title}</h2><p>{pillar.description}</p></article>)}
				</div>
				<div class="about-divider"></div>
				<p class="eyebrow">{aboutContent.backgroundHeading}</p>
				<p class="background-copy">{aboutBackground}</p>
			</WindowPanel>

			<WindowPanel filename="education.html">
				<p class="eyebrow">{aboutContent.educationHeading}</p>
				<div class="education-list">
					{education.map((item, index) => <article class="education-entry">
						<span class="education-index">0{index + 1}</span>
						<div class="education-main"><h2>{item.school}</h2><p>{item.degree}</p></div>
						<div class="education-meta"><span>{item.period}</span><span class="education-status">{item.status}</span></div>
					</article>)}
				</div>
			</WindowPanel>

			<WindowPanel filename="experience.html">
				<p class="eyebrow">{aboutContent.experienceHeading}</p>
				<div class="about-two">
					{employmentHistory.map((job) => <article class="about-item">
						<p class="item-period">{job.period}</p>
						<h2 class="item-title">{job.company}</h2>
						<div class="role-list">{job.roles.map((role) => <div class="role-row"><div class="role-heading"><strong>{role.title}</strong><span class="role-date">{role.date}</span></div><p>{role.text}</p></div>)}</div>
					</article>)}
				</div>
			</WindowPanel>

			<WindowPanel filename="toolkit.html">
				<p class="eyebrow">{aboutContent.stackHeading}</p>
				<div class="stack-grid">
					{skillGroups.map((group) => <section><p class="eyebrow">{group.label}</p><div>{group.items.map((skill) => <div class="skill"><span class="skill-name">{skill.name}</span><span class="skill-bar"><i style={`width:${skill.level}%`}></i></span></div>)}</div></section>)}
				</div>
			</WindowPanel>
		</div>
	</section>
</Layout>